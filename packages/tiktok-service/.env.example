# TikTok Service — Environment Variables
# Copy to .env and fill in values

# Supabase (same project as apps/web)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Auth secret — must match TIKTOK_SERVICE_SECRET in apps/web/.env.local
SERVICE_SECRET=dev-secret-local-123

# Port (default: 3001)
PORT=3001
